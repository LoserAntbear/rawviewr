{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@EXTENSION/*": ["src/domains/extension/*"],
      "@SHARED/*": ["src/domains/shared/*"],
      "@WEBVIEW/*": ["src/domains/webview/*"],
      "@definitions/*": ["src/definitions/*"],
      "@domains/*": ["src/domains/*"],
      "@extensions/*": ["src/extensions/*"],
      "@guards/*": ["src/guards/*"],
      "@utils/*": ["src/utils/*"],
      "@app-types/*": ["src/types/*.d.ts"],
      "@root/*": ["src/*"],
      "@packageRoot/*": ["./*"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "resolveJsonModule": true
  }
}
