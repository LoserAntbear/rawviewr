{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@common/*": ["src/common/*"],
      "@definitions/*": ["src/definitions/*"],
      "@features/*": ["src/features/*"],
      "@utils/*": ["src/utils/*"],
      "@webview/*": ["src/features/webview/*"],
      "@root/*": ["src/*"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src"]
}
