{
  "name": "raw-image-viewer",
  "displayName": "Raw Image Viewer",
  "description": "View raw / headerless image buffers (framebuffer dumps, sprite blobs, byte arrays) with switchable pixel formats, manual geometry and a multi-image gallery.",
  "version": "0.1.0",
  "publisher": "romandyro",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "raw",
    "framebuffer",
    "rgba4444",
    "rgb565",
    "hex",
    "binary",
    "image"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "rawImageViewer.editor",
        "displayName": "Raw Image Viewer",
        "selector": [
          {
            "filenamePattern": "*.raw"
          },
          {
            "filenamePattern": "*.imag"
          },
          {
            "filenamePattern": "*.fb"
          },
          {
            "filenamePattern": "*.rgb"
          },
          {
            "filenamePattern": "*.rgba"
          },
          {
            "filenamePattern": "*.bgra"
          },
          {
            "filenamePattern": "*.argb"
          },
          {
            "filenamePattern": "*.565"
          },
          {
            "filenamePattern": "*.4444"
          },
          {
            "filenamePattern": "*.gray"
          },
          {
            "filenamePattern": "*.pix"
          },
          {
            "filenamePattern": "*.tex"
          },
          {
            "filenamePattern": "*.yuv"
          },
          {
            "filenamePattern": "*.yv12"
          },
          {
            "filenamePattern": "*.yuv444"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "rawImageViewer.editor.optional",
        "displayName": "Raw Image Viewer",
        "selector": [
          {
            "filenamePattern": "*.bin"
          },
          {
            "filenamePattern": "*.dat"
          },
          {
            "filenamePattern": "*.data"
          },
          {
            "filenamePattern": "*.dump"
          },
          {
            "filenamePattern": "*.img"
          },
          {
            "filenamePattern": "*"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "rawImageViewer.open",
        "title": "Open in Raw Image Viewer",
        "category": "Raw Image"
      },
      {
        "command": "rawImageViewer.openGallery",
        "title": "Open as Raw Image Gallery",
        "category": "Raw Image"
      },
      {
        "command": "rawImageViewer.openFolderGallery",
        "title": "Open Folder as Raw Image Gallery",
        "category": "Raw Image"
      },
      {
        "command": "rawImageViewer.zoomIn",
        "title": "Zoom In",
        "category": "Raw Image"
      },
      {
        "command": "rawImageViewer.zoomOut",
        "title": "Zoom Out",
        "category": "Raw Image"
      },
      {
        "command": "rawImageViewer.zoomReset",
        "title": "Zoom to 1:1",
        "category": "Raw Image"
      },
      {
        "command": "rawImageViewer.resetSettings",
        "title": "Reset Remembered Decode Settings",
        "category": "Raw Image"
      },
      {
        "command": "rawImageViewer.revealItem",
        "title": "Reveal in Explorer View",
        "category": "Raw Image"
      },
      {
        "command": "rawImageViewer.captureGpuTrace",
        "title": "Capture GPU Trace",
        "category": "Raw Image"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "rawImageViewer.open",
          "group": "3_rawimage@1",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "rawImageViewer.openGallery",
          "group": "3_rawimage@2",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "rawImageViewer.openFolderGallery",
          "group": "3_rawimage@2",
          "when": "explorerResourceIsFolder"
        }
      ],
      "commandPalette": [
        {
          "command": "rawImageViewer.zoomIn",
          "when": "activeCustomEditorId =~ /^rawImageViewer\\.editor/ || activeWebviewPanelId == 'rawImageViewer.gallery'"
        },
        {
          "command": "rawImageViewer.zoomOut",
          "when": "activeCustomEditorId =~ /^rawImageViewer\\.editor/ || activeWebviewPanelId == 'rawImageViewer.gallery'"
        },
        {
          "command": "rawImageViewer.zoomReset",
          "when": "activeCustomEditorId =~ /^rawImageViewer\\.editor/ || activeWebviewPanelId == 'rawImageViewer.gallery'"
        },
        {
          "command": "rawImageViewer.revealItem",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "rawImageViewer.revealItem",
          "when": "webviewId == 'rawImageViewer.gallery' && actionTarget == 'galleryItem'"
        }
      ]
    },
    "keybindings": [
      {
        "key": "=",
        "command": "rawImageViewer.zoomIn",
        "when": "(activeCustomEditorId =~ /^rawImageViewer\\.editor/ || activeWebviewPanelId == 'rawImageViewer.gallery') && !rawImageViewer.fieldFocus"
      },
      {
        "key": "shift+=",
        "command": "rawImageViewer.zoomIn",
        "when": "(activeCustomEditorId =~ /^rawImageViewer\\.editor/ || activeWebviewPanelId == 'rawImageViewer.gallery') && !rawImageViewer.fieldFocus"
      },
      {
        "key": "-",
        "command": "rawImageViewer.zoomOut",
        "when": "(activeCustomEditorId =~ /^rawImageViewer\\.editor/ || activeWebviewPanelId == 'rawImageViewer.gallery') && !rawImageViewer.fieldFocus"
      },
      {
        "key": "0",
        "command": "rawImageViewer.zoomReset",
        "when": "(activeCustomEditorId =~ /^rawImageViewer\\.editor/ || activeWebviewPanelId == 'rawImageViewer.gallery') && !rawImageViewer.fieldFocus"
      }
    ],
    "configuration": {
      "title": "Raw Image Viewer",
      "properties": {
        "rawImageViewer.defaultFormat": {
          "type": "string",
          "default": "rgba4444",
          "enum": [
            "rgba4444",
            "argb4444",
            "abgr4444",
            "bgra4444",
            "rgbx4444",
            "xrgb4444",
            "rgb565",
            "bgr565",
            "rgba5551",
            "bgra5551",
            "argb1555",
            "abgr1555",
            "xrgb1555",
            "rgb332",
            "bgr233",
            "rgb888",
            "bgr888",
            "rgba8888",
            "argb8888",
            "abgr8888",
            "bgra8888",
            "rgbx8888",
            "xrgb8888",
            "bgrx8888",
            "xbgr8888",
            "yuyv",
            "uyvy",
            "yvyu",
            "vyuy",
            "yuv444",
            "vuy444",
            "gray8",
            "alpha8",
            "gray16",
            "gray4",
            "gray2",
            "gray1",
            "imag"
          ],
          "description": "Pixel format used when a buffer is opened for the first time.",
          "enumDescriptions": [
            "RGBA4444",
            "ARGB4444",
            "ABGR4444",
            "BGRA4444",
            "RGBX4444 \u2014 alpha nibble ignored",
            "XRGB4444 \u2014 alpha nibble ignored",
            "RGB565",
            "BGR565",
            "RGBA5551",
            "BGRA5551",
            "ARGB1555",
            "ABGR1555",
            "XRGB1555 \u2014 top bit ignored",
            "RGB332",
            "BGR233",
            "RGB888 \u2014 bytes R,G,B",
            "BGR888 \u2014 bytes B,G,R",
            "RGBA8888 \u2014 bytes R,G,B,A",
            "ARGB8888 \u2014 bytes A,R,G,B",
            "ABGR8888 \u2014 bytes A,B,G,R",
            "BGRA8888 \u2014 bytes B,G,R,A",
            "RGBX8888 \u2014 bytes R,G,B,pad",
            "XRGB8888 \u2014 bytes pad,R,G,B",
            "BGRX8888 \u2014 bytes B,G,R,pad",
            "XBGR8888 \u2014 bytes pad,B,G,R",
            "YUYV / YUY2 \u2014 4:2:2, bytes Y0,U,Y1,V",
            "UYVY \u2014 4:2:2, bytes U,Y0,V,Y1",
            "YVYU \u2014 4:2:2, bytes Y0,V,Y1,U",
            "VYUY \u2014 4:2:2, bytes V,Y0,U,Y1",
            "YUV444 \u2014 4:4:4 packed, bytes Y,U,V",
            "VUY444 \u2014 4:4:4 packed, bytes V,U,Y",
            "GRAY8 \u2014 8-bit luminance",
            "A8 \u2014 8-bit alpha only",
            "GRAY16 \u2014 16-bit luminance (high byte shown)",
            "GRAY4 \u2014 4-bit, 2 px/byte",
            "GRAY2 \u2014 2-bit, 4 px/byte",
            "GRAY1 \u2014 1-bit mono, 8 px/byte",
            "IMAG \u2014 LZ77-compressed ARGB4444 sprite, sized by its own header"
          ]
        },
        "rawImageViewer.defaultWidth": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Default width in pixels. 0 lets the viewer guess from the buffer size."
        },
        "rawImageViewer.defaultHeight": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Default height in pixels. 0 derives the height from the buffer size and width."
        },
        "rawImageViewer.defaultOffset": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Bytes skipped before the first pixel (header size)."
        },
        "rawImageViewer.defaultLittleEndian": {
          "type": "boolean",
          "default": true,
          "description": "Byte order used to read packed 16/32-bit pixels."
        },
        "rawImageViewer.defaultAlphaMode": {
          "type": "string",
          "default": "use",
          "enum": [
            "use",
            "ignore"
          ],
          "enumDescriptions": [
            "Honour the alpha channel of the pixel format.",
            "Force every pixel opaque (useful for buffers with garbage alpha)."
          ],
          "description": "How the alpha channel is treated on first open."
        },
        "rawImageViewer.defaultBackground": {
          "type": "string",
          "default": "checker",
          "enum": [
            "checker",
            "black",
            "white",
            "magenta",
            "editor"
          ],
          "description": "Backdrop a view starts with, behind transparent pixels. Change it per view from the toolbar."
        },
        "rawImageViewer.tileSize": {
          "type": "number",
          "default": 160,
          "minimum": 48,
          "maximum": 512,
          "description": "Tile edge length (px) in the gallery view."
        },
        "rawImageViewer.maxFileSizeMB": {
          "type": "number",
          "default": 512,
          "minimum": 1,
          "description": "Refuse to load buffers larger than this, to keep the webview responsive."
        },
        "rawImageViewer.galleryIncludeGlob": {
          "type": "string",
          "default": "**/*.{raw,imag,bin,dat,data,dump,fb,rgb,rgba,bgra,argb,565,4444,gray,pix,tex,img,yuv,yv12,yuv444}",
          "description": "Glob used by \"Open Folder as Raw Image Gallery\" to collect files."
        },
        "rawImageViewer.capture.command": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Program run to capture a frame. Leave this empty to use the tool built in for your platform \u2014 on macOS that is Xcode's /usr/bin/gpucapture, which needs no configuration at all. Set it to take over instead: it is executed directly rather than through a shell, so it needs an absolute path unless it is on the PATH that VS Code itself was launched with, and a pipeline means setting this to \"sh\" and putting the pipeline in Args. Your own tool is assumed to write a raw buffer, so the path it is handed ends in .raw."
        },
        "rawImageViewer.capture.args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "scope": "machine",
          "description": "Arguments for your own capture command, one per element rather than one string. Ignored while Command is empty, because a built-in tool owns its command line and has nothing to substitute into. ${output} is replaced with the path to write to, ${pid} with a capturable process you are asked to pick, and ${workspaceFolder} with the first open folder. ${config:...} is not supported, on purpose: it would let a workspace inject settings into the argv of a program we run."
        },
        "rawImageViewer.capture.outputType": {
          "type": "string",
          "default": "file",
          "enum": [
            "stdout",
            "file"
          ],
          "enumDescriptions": [
            "The tool streams the frame to its standard output, and we save it.",
            "The tool writes the frame itself, at the path substituted into ${output}."
          ],
          "scope": "machine",
          "description": "How your own capture command hands over the frame. \"file\" means it writes the path given to it as ${output}; \"stdout\" means it streams the bytes out instead and needs no path. Ignored while Command is empty, because a built-in tool knows how it reports its own output."
        },
        "rawImageViewer.capture.stopWith": {
          "type": "string",
          "default": "sigint",
          "enum": [
            "sigint",
            "sigterm",
            "stdin-q"
          ],
          "enumDescriptions": [
            "Send SIGINT. POSIX only.",
            "Send SIGTERM. POSIX only.",
            "Write \"q\" to the tool's standard input. The only graceful stop that works on Windows."
          ],
          "scope": "machine",
          "description": "How a recording is ended gracefully, so the tool gets to finalise its output."
        },
        "rawImageViewer.capture.timeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 3600,
          "scope": "machine",
          "description": "Hang deadline."
        },
        "rawImageViewer.capture.maxOutputMB": {
          "type": "number",
          "default": 256,
          "minimum": 1,
          "maximum": 4096,
          "scope": "machine",
          "description": "Memory limit for the capture output in megabytes."
        },
        "rawImageViewer.capture.saveFolder": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "The folder address where you want to save the capture output."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "vscode:prepublish": "npm run package",
    "watch": "npm-run-all -p watch:*",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run typecheck && npm run build -- --production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "vsix": "npx --yes @vscode/vsce package --no-dependencies -o raw-image-viewer.vsix",
    "vsix:local": "npx --yes @vscode/vsce package --baseContentUrl https://none --baseImagesUrl https://none --no-dependencies -o raw-image-viewer-local.vsix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.7.5",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "happy-dom": "^20.14.5",
    "npm-run-all": "^1.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
